# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=put_your_bot_token_here

# Required: channel ID where submitted applications should be sent (private staff channel)
STAFF_CHANNEL_ID=put_private_staff_channel_id_here

# Optional: restrict setup commands to this server. Leave empty to allow any server admins.
GUILD_ID=

# Optional embed colour, as a hex number without # (default: 5865F2)
EMBED_COLOR=5865F2